# =============================================================================
# AgentHub · nginx 反向代理样例
#
# 使用前请按实际替换：
#   1) server_name       -> 与 config.json 的 server.domain 一致
#   2) ssl_certificate / ssl_certificate_key -> 你的证书路径
#   3) proxy_pass 后端端口 -> 默认 127.0.0.1:8080，与 server.listen_addr 一致
# 复制：sudo cp deploy/nginx.conf.example /etc/nginx/conf.d/agenthub.conf
# 校验：sudo nginx -t && sudo systemctl reload nginx
# =============================================================================

# ★日志脱敏（§7.1 / K7）：只记录 $uri，绝不记录 $request / $args
#   WS 握手 URL 形如 /api/v1/ws/client?token=<登录token>，若记录 $args 会把 token 落盘。
log_format agenthub '$remote_addr $request_method $uri $status $body_bytes_sent '
                    '$http_user_agent $request_time';
access_log /var/log/nginx/agenthub.access.log agenthub;
error_log  /var/log/nginx/agenthub.error.log warn;

server {
    # 「listen 443 ssl http2;」在 nginx ≥1.25.1 已废弃，改为 listen + 独立的 http2 指令。
    # 若你的 nginx ≤1.25.0（不支持 http2 指令），请改成「listen 443 ssl http2;」并删除下一行。
    listen 443 ssl;
    http2 on;
    server_name agent-hub.xxxx.com;

    ssl_certificate     /etc/letsencrypt/live/agent-hub.xxxx.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent-hub.xxxx.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 单条 prompt 上限 64KiB（MESSAGE_TOO_LARGE=4002），2m 足够
    client_max_body_size 2m;

    # -------------------------------------------------------------------------
    # 两条 WebSocket 通道：必须 Upgrade + 长 read_timeout + 关闭缓冲
    # -------------------------------------------------------------------------
    location /api/v1/ws/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 必须 > 服务端 pongWait(60s)，否则空闲长连接被 nginx 掐断
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # 流式 chat.chunk 不被缓冲，逐帧即时到达浏览器
        proxy_buffering off;
    }

    # -------------------------------------------------------------------------
    # REST + 内嵌前端（SPA fallback 由 Go 侧 staticHandler 处理）
    # -------------------------------------------------------------------------
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# HTTP 全量跳转 HTTPS（公网强制 WSS）
server {
    listen 80;
    server_name agent-hub.xxxx.com;
    return 301 https://$host$request_uri;
}
